{
  "name": "daily-task-mover",
  "version": "0.2.4",
  "description": "Move the task to the same heading on the previous or next day.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "npx eslint \"src/**/*.ts\" main.ts",
    "lint:fix": "npx eslint \"src/**/*.ts\" main.ts --fix",
    "test": "node --test tests/*.cjs"
  },
  "keywords": [
    "daily-notes",
    "tasks"
  ],
  "author": "moz",
  "license": "MIT",
  "dependencies": {
    "obsidian-daily-notes-interface": "^0.9.5"
  },
  "devDependencies": {
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "esbuild": "^0.20.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "globals": "^17.0.0",
    "obsidian": "^1.5.0",
    "tslib": "^2.6.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.53.0"
  },
  "peerDependencies": {
    "obsidian": "^1.5.0"
  }
}
