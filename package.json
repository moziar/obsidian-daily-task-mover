    "daily-notes",
    "tasks"
  ],
  "author": "moz",
  "license": "MIT",
  "dependencies": {
    "obsidian-daily-notes-interface": "^0.9.5"
  },
  "devDependencies": {
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@types/node": "^20.11.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.20.0",
    "tslib": "^2.6.0",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "obsidian": "^1.5.0"
  }
}
